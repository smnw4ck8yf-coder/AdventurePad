<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- SAF grants do not migrate; never transfer ownership claims without their tree. -->
        <exclude domain="file" path="cocoon-integration/" />
        <exclude domain="sharedpref" path="cocoon_integration.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cocoon-integration/" />
        <exclude domain="sharedpref" path="cocoon_integration.xml" />
    </device-transfer>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>
